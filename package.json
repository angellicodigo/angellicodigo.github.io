{
  "name": "fotografias",
  "version": "5.0.0",
  "description": "Photography portfolio website template",
  "private": true,
  "scripts": {
    "build:css": "sass assets/sass/main.scss:assets/css/main.min.css assets/sass/custom.scss:assets/css/custom.min.css assets/sass/noscript.scss:assets/css/noscript.min.css --style=compressed --no-source-map --quiet",
    "watch:css": "sass assets/sass/main.scss:assets/css/main.min.css assets/sass/custom.scss:assets/css/custom.min.css assets/sass/noscript.scss:assets/css/noscript.min.css --style=compressed --no-source-map --quiet --watch",
    "build": "npm run build:css",
    "test": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.85.0"
  }
}
